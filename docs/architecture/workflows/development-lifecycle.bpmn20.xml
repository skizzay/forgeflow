<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" targetNamespace="https://forgeflow.io/reference">
  <!-- Proposed non-executable reference for issue #100. No handlers, deployment or runtime authorization. See ../workflow-reference.md. -->
  <message id="newTicket" name="Verified new ticket"/>
  <message id="humanDecision" name="Authenticated human decision"/>
  <message id="processObservation" name="Verified correlated repository ticket or reconciliation observation"/>
  <message id="workerOutcome" name="Accepted fenced worker outcome"/>
  <process id="epicCoordinationReference" name="Epic coordination" isExecutable="false">
    <startEvent id="ticketReceived" name="Verified new-ticket webhook"><messageEventDefinition messageRef="newTicket"/></startEvent>
    <task id="planWork" name="Read ticket and draft validated plan"/>
    <receiveTask id="awaitPlanApproval" name="Wait for explicit human plan decision" messageRef="humanDecision"/>
    <exclusiveGateway id="planDecision" name="Plan approved?"/>
    <task id="prepareEpic" name="Prepare epic branch from approved main"/>
    <task id="selectStory" name="Select dependency-ready story"/>
    <exclusiveGateway id="storyEligibility" name="Story eligibility?"/>
    <receiveTask id="awaitDependency" name="Wait for ticket or verified dependency merge" messageRef="processObservation"/>
    <callActivity id="deliverStory" name="Deliver one approved story" calledElement="storyDeliveryReference"/>
    <exclusiveGateway id="storyResult" name="Story result?"/>
    <task id="verifyEpic" name="Verify epic acceptance and architecture"/>
    <exclusiveGateway id="epicChecks" name="Epic checks passed?"/>
    <task id="publishEpicPR" name="Publish epic-to-main PR"/>
    <callActivity id="reviewEpic" name="Review epic PR and obtain final human merge approval" calledElement="reviewMergeReference"/>
    <exclusiveGateway id="epicResult" name="Final PR result?"/>
    <endEvent id="epicComplete" name="Verified epic-to-main merge"/>
    <task id="epicHold" name="Hold and escalate to human"/>
    <endEvent id="epicHeld" name="Held; no automatic continuation"/>
    <sequenceFlow id="epicCoordinationReference_flow_0" sourceRef="ticketReceived" targetRef="planWork" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_1" sourceRef="planWork" targetRef="awaitPlanApproval" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_2" sourceRef="awaitPlanApproval" targetRef="planDecision" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_3" sourceRef="planDecision" targetRef="prepareEpic" name="approved exact plan"/>
    <sequenceFlow id="epicCoordinationReference_flow_4" sourceRef="planDecision" targetRef="epicHold" name="rejected or uncertain"/>
    <sequenceFlow id="epicCoordinationReference_flow_5" sourceRef="prepareEpic" targetRef="selectStory" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_6" sourceRef="selectStory" targetRef="storyEligibility" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_7" sourceRef="storyEligibility" targetRef="deliverStory" name="ready and currently approved"/>
    <sequenceFlow id="epicCoordinationReference_flow_8" sourceRef="storyEligibility" targetRef="awaitDependency" name="blocked"/>
    <sequenceFlow id="epicCoordinationReference_flow_9" sourceRef="awaitDependency" targetRef="selectStory" name="re-evaluate current facts"/>
    <sequenceFlow id="epicCoordinationReference_flow_10" sourceRef="storyEligibility" targetRef="verifyEpic" name="all children verified merged"/>
    <sequenceFlow id="epicCoordinationReference_flow_11" sourceRef="deliverStory" targetRef="storyResult" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_12" sourceRef="storyResult" targetRef="selectStory" name="verified merged; unlock dependents"/>
    <sequenceFlow id="epicCoordinationReference_flow_13" sourceRef="storyResult" targetRef="epicHold" name="closed or held"/>
    <sequenceFlow id="epicCoordinationReference_flow_14" sourceRef="verifyEpic" targetRef="epicChecks" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_15" sourceRef="epicChecks" targetRef="publishEpicPR" name="passed"/>
    <sequenceFlow id="epicCoordinationReference_flow_16" sourceRef="epicChecks" targetRef="epicHold" name="failed or unknown"/>
    <sequenceFlow id="epicCoordinationReference_flow_17" sourceRef="publishEpicPR" targetRef="reviewEpic" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_18" sourceRef="reviewEpic" targetRef="epicResult" name=""/>
    <sequenceFlow id="epicCoordinationReference_flow_19" sourceRef="epicResult" targetRef="epicComplete" name="verified authorized merge"/>
    <sequenceFlow id="epicCoordinationReference_flow_20" sourceRef="epicResult" targetRef="epicHold" name="closed or held"/>
    <sequenceFlow id="epicCoordinationReference_flow_21" sourceRef="epicHold" targetRef="epicHeld" name=""/>
  </process>
  <process id="storyDeliveryReference" name="Story delivery" isExecutable="false">
    <startEvent id="storyStart" name="Approved eligible story"/>
    <task id="prepareStoryBranch" name="Prepare fresh story branch from epic"/>
    <task id="dispatchImplementation" name="Dispatch isolated coding and testing"/>
    <receiveTask id="awaitImplementation" name="Wait for accepted fenced worker outcome" messageRef="workerOutcome"/>
    <exclusiveGateway id="implementationResult" name="Verified tests passed?"/>
    <task id="publishStoryPR" name="Publish tested story PR targeting epic"/>
    <callActivity id="reviewStory" name="Review story PR and obtain human merge approval" calledElement="reviewMergeReference"/>
    <endEvent id="storyFinished" name="Return verified review outcome to epic"/>
    <task id="storyHold" name="Hold and escalate to human"/>
    <endEvent id="storyHeld" name="Return held outcome"/>
    <sequenceFlow id="storyDeliveryReference_flow_0" sourceRef="storyStart" targetRef="prepareStoryBranch" name=""/>
    <sequenceFlow id="storyDeliveryReference_flow_1" sourceRef="prepareStoryBranch" targetRef="dispatchImplementation" name=""/>
    <sequenceFlow id="storyDeliveryReference_flow_2" sourceRef="dispatchImplementation" targetRef="awaitImplementation" name=""/>
    <sequenceFlow id="storyDeliveryReference_flow_3" sourceRef="awaitImplementation" targetRef="implementationResult" name=""/>
    <sequenceFlow id="storyDeliveryReference_flow_4" sourceRef="implementationResult" targetRef="publishStoryPR" name="passed for exact tested head"/>
    <sequenceFlow id="storyDeliveryReference_flow_5" sourceRef="implementationResult" targetRef="storyHold" name="failed or uncertain"/>
    <sequenceFlow id="storyDeliveryReference_flow_6" sourceRef="publishStoryPR" targetRef="reviewStory" name=""/>
    <sequenceFlow id="storyDeliveryReference_flow_7" sourceRef="reviewStory" targetRef="storyFinished" name="merged or closed or held"/>
    <sequenceFlow id="storyDeliveryReference_flow_8" sourceRef="storyHold" targetRef="storyHeld" name=""/>
  </process>
  <process id="reviewMergeReference" name="Repository review and merge" isExecutable="false">
    <startEvent id="reviewStart" name="Bound story or epic PR"/>
    <task id="requestReview" name="Request Copilot or configured reviewer for current head"/>
    <receiveTask id="awaitReviewEvent" name="Wait for verified correlated observation" messageRef="processObservation"/>
    <task id="inspectReview" name="Read authoritative review checks head closure and approval"/>
    <exclusiveGateway id="reviewDecision" name="Verified review outcome?"/>
    <task id="dispatchRemediation" name="Increment attempt budget and dispatch remediation with tests"/>
    <receiveTask id="awaitRemediation" name="Wait for accepted fenced remediation outcome" messageRef="workerOutcome"/>
    <exclusiveGateway id="remediationResult" name="Verified remediation tests passed?"/>
    <task id="publishRemediation" name="Publish tested new head; invalidate stale approvals"/>
    <receiveTask id="awaitMergeApproval" name="Wait for explicit human approval of exact PR base and head" messageRef="humanDecision"/>
    <task id="revalidateMerge" name="Revalidate human authority checks and exact binding"/>
    <exclusiveGateway id="mergeGuards" name="Merge guards satisfied?"/>
    <task id="requestMerge" name="Request merge through repository port"/>
    <endEvent id="reviewMerged" name="Return verified authorized merged outcome"/>
    <endEvent id="reviewClosed" name="Return closed-without-merge outcome"/>
    <task id="reviewHold" name="Hold and escalate; reconcile uncertain effects"/>
    <endEvent id="reviewHeld" name="Return held outcome"/>
    <sequenceFlow id="reviewMergeReference_flow_0" sourceRef="reviewStart" targetRef="requestReview" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_1" sourceRef="requestReview" targetRef="awaitReviewEvent" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_2" sourceRef="awaitReviewEvent" targetRef="inspectReview" name="webhook or trusted reconciliation observation"/>
    <sequenceFlow id="reviewMergeReference_flow_3" sourceRef="inspectReview" targetRef="reviewDecision" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_4" sourceRef="reviewDecision" targetRef="awaitReviewEvent" name="incomplete review or checks; comment alone"/>
    <sequenceFlow id="reviewMergeReference_flow_5" sourceRef="reviewDecision" targetRef="requestReview" name="head changed; fresh review needed"/>
    <sequenceFlow id="reviewMergeReference_flow_6" sourceRef="reviewDecision" targetRef="dispatchRemediation" name="completed review; actionable; authorized; attempts below 2"/>
    <sequenceFlow id="reviewMergeReference_flow_7" sourceRef="dispatchRemediation" targetRef="awaitRemediation" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_8" sourceRef="awaitRemediation" targetRef="remediationResult" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_9" sourceRef="remediationResult" targetRef="publishRemediation" name="passed"/>
    <sequenceFlow id="reviewMergeReference_flow_10" sourceRef="remediationResult" targetRef="reviewHold" name="failed or uncertain"/>
    <sequenceFlow id="reviewMergeReference_flow_11" sourceRef="publishRemediation" targetRef="requestReview" name="request re-review; retain attempt count"/>
    <sequenceFlow id="reviewMergeReference_flow_12" sourceRef="reviewDecision" targetRef="awaitMergeApproval" name="current-head review and required checks pass"/>
    <sequenceFlow id="reviewMergeReference_flow_13" sourceRef="awaitMergeApproval" targetRef="revalidateMerge" name="authenticated human command"/>
    <sequenceFlow id="reviewMergeReference_flow_14" sourceRef="revalidateMerge" targetRef="mergeGuards" name=""/>
    <sequenceFlow id="reviewMergeReference_flow_15" sourceRef="mergeGuards" targetRef="requestMerge" name="authorized exact base and head"/>
    <sequenceFlow id="reviewMergeReference_flow_16" sourceRef="mergeGuards" targetRef="requestReview" name="head changed; approval stale"/>
    <sequenceFlow id="reviewMergeReference_flow_17" sourceRef="mergeGuards" targetRef="reviewHold" name="revoked or unsupported or uncertain"/>
    <sequenceFlow id="reviewMergeReference_flow_18" sourceRef="requestMerge" targetRef="awaitReviewEvent" name="await or reconcile provider closure"/>
    <sequenceFlow id="reviewMergeReference_flow_19" sourceRef="reviewDecision" targetRef="reviewMerged" name="verified authorized merge with exact binding"/>
    <sequenceFlow id="reviewMergeReference_flow_20" sourceRef="reviewDecision" targetRef="reviewClosed" name="verified closed without merge"/>
    <sequenceFlow id="reviewMergeReference_flow_21" sourceRef="reviewDecision" targetRef="reviewHold" name="ambiguous or exhausted budget or revoked approval"/>
    <sequenceFlow id="reviewMergeReference_flow_22" sourceRef="reviewHold" targetRef="reviewHeld" name=""/>
  </process>
